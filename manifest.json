{
  "schemaVersion": 1,
  "id": "quickshell.roon",
  "name": "Roon",
  "version": "0.2.1",
  "author": "ph0bos",
  "description": "Roon in the Omarchy shell: what is playing in your zone, an endpoint on this machine, transport, zone switching, and a summonable player with the queue.",
  "kinds": [
    "service",
    "bar-widget",
    "overlay"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "qml/Service.qml",
    "barWidget": "qml/BarWidget.qml",
    "overlay": "qml/Overlay.qml"
  },
  "barWidget": {
    "displayName": "Roon",
    "description": "Roon zone now-playing with transport controls",
    "category": "Media",
    "allowMultiple": false,
    "defaults": {
      "showZoneName": true,
      "showLabel": true,
      "maxLabelWidth": 220,
      "scrollLongLabels": true
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "bool",
        "label": "Show track title"
      },
      {
        "key": "showZoneName",
        "type": "bool",
        "label": "Show zone name"
      },
      {
        "key": "maxLabelWidth",
        "type": "int",
        "label": "Max label width (px)"
      },
      {
        "key": "scrollLongLabels",
        "type": "bool",
        "label": "Scroll long titles"
      }
    ]
  },
  "license": "MIT",
  "repository": "https://github.com/ph0bos/omarchy-roon-client"
}
